{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": { "maxDuration": 120 }
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "*.png",
      "use": "@vercel/static"
    },
    {
      "src": "*.svg",
      "use": "@vercel/static"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/(.*\\.(css|js|png|svg|jpg|jpeg|gif|ico|woff|woff2|ttf|eot))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "MODERACAO_PIPELINE_V2": "true",
    "RESPOSTA_PIPELINE_MODE": "pev",
    "PEV_PLAN_EXEC_ENABLED": "true",
    "PEV_RA_STANDARD_ENABLED": "true",
    "PEV_CHANCE_MODERACAO_ENABLED": "true"
  },
  "crons": [
    {
      "path": "/api/cron/lembrete-marcacoes",
      "schedule": "0 12 * * 1-5"
    }
  ]
}
